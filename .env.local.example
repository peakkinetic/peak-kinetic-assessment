# Copy to .env.local and fill in from Supabase → Project Settings → API

# MUST be your Supabase project URL (ends with .supabase.co) — NOT your custom domain
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Coach login:
# - Without Supabase env vars, demo logins are defined in src/data/localCoaches.ts
# - With Supabase configured, create coach users in Supabase Auth (email + password)
#   and optionally add rows to coach_profiles (see supabase/coach-auth.sql)
